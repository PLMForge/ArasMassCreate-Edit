<compatibility>
	<!--
		Lowest Innovator release this package installs into. That release and
		every later one are accepted. Built for 14.0.25 (Innovator 2024) and
		14.35.0 (Innovator 2025).

		Both modules compare it as a version number with the release of the
		Innovator they install into.
	-->
	<minimum_innovator version="14.0.25" />
</compatibility>
