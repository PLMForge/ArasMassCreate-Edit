<?xml version="1.0" encoding="utf-8"?>
<package>
	<info>
		<name>FRG_MassCreateEdit</name>
		<label>FRG Mass Create &amp; Edit</label>
		<version>1.0.0</version>
		<version_label>Release 1 (1.0.0)</version_label>
		<type>aia</type>
		<owner>FRG</owner>
		<description>Lets Aras Innovator users create and edit items in bulk with Excel. A user generates a workbook for one or more ItemTypes, optionally with some of their relationships, fills it in and uploads it. The server then checks every cell and shows each row as new, changed or unchanged before anything is written. Deploys the client files to the Innovator client code tree and imports the tool's items into the database.</description>
		<copyright>FRG</copyright>
		<!-- Requires Aras Update 1.18 or later. -->
		<tool_minimal_version_required>1.18</tool_minimal_version_required>
	</info>

	<installation>
		<!--
			=====================================================================
			MAINTAINER NOTE - read before editing any attribute value below.

			Keep the letter sequences lowercase "not" and uppercase "AND" / "OR"
			out of attribute values and element text, also inside other words
			("cannot", "nothing", "ERROR"), here and in
			Resources/resource.neutral. Comments may use them. Check with:
			    grep -oE 'message="[^"]*"' package.config | grep -nE 'not|AND|OR'
			=====================================================================

			Code tree module.

			Copies the client files into Client/customer/masscreateedit/, raises
			filesRevision in InnovatorClient.config so that browsers load the new
			files, and restarts the Client application. It changes no other
			Innovator file.
		-->
		<module id="IS" label="@{Pkg.IS.Label}" description="@{Pkg.IS.Desc}" required_properties="Innovator.Dir">

			<dependencies>
				<!--
					PREFLIGHT. Both files this module reads must exist before anything
					runs, so a wrong Innovator.Dir fails here with a clear message
					instead of partway through the install.

					The property is set to "false" first on purpose: the check passes
					only once both files have been found.
				-->
				<custom property="FRG.Preflight">
					<property name="FRG.Preflight" value="false" />
					<property name="RevInc" value="${Innovator.Dir}\Client\scripts\include\rev.inc" />
					<property name="Client.Config" value="${Innovator.Dir}\Client\InnovatorClient.config" />
					<if test="${file::exists(RevInc)}">
						<if test="${file::exists(Client.Config)}">
							<property name="FRG.Preflight" value="true" />
						</if>
					</if>
					<if test="${not(file::exists(RevInc))}">
						<echo message="PREFLIGHT FAILED: missing ${RevInc} - check the Install Path. It must be the Innovator folder holding Client and Server." />
					</if>
					<if test="${not(file::exists(Client.Config))}">
						<echo message="PREFLIGHT FAILED: missing ${Client.Config} - check the Install Path." />
					</if>
				</custom>

				<custom property="Version.Check">
					<property name="Version.Check" value="false" />
					<property name="RevInc.Label" value="" />
					<!-- encoding is explicit so that a UTF-8 BOM in rev.inc cannot break
					     the version comparison below. -->
					<loadfile file="${RevInc}" property="RevInc.Label" encoding="utf-8" />
					<!-- Any release at or above the minimum in compatibility.config is
					     accepted. System.Version compares numerically, so 14.100.0 is
					     correctly later than 14.35.0. -->
					<property name="MinimumRelease" value="" />
					<xmlpeek file="${Package.Dir}\compatibility.config" xpath="/compatibility/minimum_innovator/@version" property="MinimumRelease" failonerror="false" />
					<echo message="Detected Innovator release: ${RevInc.Label} (minimum supported: ${MinimumRelease})" />
					<if test="${RevInc.Label != '' AND MinimumRelease != '' AND System.Version.Parse(RevInc.Label) &gt;= System.Version.Parse(MinimumRelease)}">
						<property name="Version.Check" value="true" />
					</if>
				</custom>
			</dependencies>

			<!--
				Raise filesRevision in InnovatorClient.config, so that browsers load
				the new client files. The default "std" becomes "1" on the first
				install, and every later install adds 1.
			-->
			<property name="FilesRevisionXpath" value="/configuration/cachingModule/@filesRevision" />
			<property name="OldFilesRevision" value="" />
			<xmlpeek file="${Client.Config}" xpath="${FilesRevisionXpath}" property="OldFilesRevision" />

			<!--
				Stop with a clear message if InnovatorClient.config has no
				filesRevision value. "cmd /c exit 1" stops the install.
			-->
			<if test="${string::get-length(OldFilesRevision) == 0}">
				<echo message="FAILED: no ${FilesRevisionXpath} found in ${Client.Config}. The cachingModule element is missing - this release may keep filesRevision elsewhere." />
				<exec program="cmd.exe" commandline="/c exit 1" failonerror="true" />
			</if>

			<property name="NewFilesRevision" value="" />
			<if test="${OldFilesRevision == 'std'}">
				<property name="NewFilesRevision" value="1" />
			</if>
			<if test="${OldFilesRevision != 'std'}">
				<property name="NewFilesRevision" value="${int::parse(OldFilesRevision) + 1}" />
			</if>
			<!-- preservewhitespace keeps the rest of the config's formatting
			     unchanged. -->
			<xmlpoke file="${Client.Config}" xpath="${FilesRevisionXpath}" value="${NewFilesRevision}" preservewhitespace="true" />
			<echo message="Client cache token: ${OldFilesRevision} -> ${NewFilesRevision}" />

			<!-- Our own files: whole-file copy, no merge needed. -->
			<copy todir="${Innovator.Dir}/Client/customer/masscreateedit/" failonerror="true">
				<fileset basedir="${Package.Dir}/Innovator/Client/customer/masscreateedit/">
					<include name="**" />
				</fileset>
			</copy>

			<!--
				Restart the Client application (that application alone, not its
				application pool), so that the new filesRevision is used.

				No output= attribute, deliberately: the script's messages then go to
				the installer log, where someone diagnosing a failed install looks.
			-->
			<exec program="powershell.exe"
			      workingdir="${Package.Dir}/Scripts"
			      commandline="-ExecutionPolicy Unrestricted -NonInteractive -File FRG_restartClientApp.ps1 -ClientDir &quot;${Innovator.Dir}\Client&quot;"
			      failonerror="true" />
		</module>

		<!--
			Database module.

			First makes sure the "Mass Operations" category exists in the
			Administration menu (see below), then imports the AML under Imports/
			(see imports.mf), then adds the "Default" configuration item where
			there is none. Safe to re-run: existing items are updated in place,
			and an existing configuration item is left alone.
		-->
		<module id="DB" label="@{Pkg.DB.Label}" description="@{Pkg.DB.Desc}" required_properties="Innovator.URL|Innovator.DB|Innovator.Username|Innovator.Password">

			<dependencies>
				<custom property="Version.Check">
					<property name="Version.Check" value="false" />
					<property name="MinimumRelease" value="" />
					<xmlpeek file="${Package.Dir}\compatibility.config" xpath="/compatibility/minimum_innovator/@version" property="MinimumRelease" failonerror="false" />
					<echo message="Connected Innovator release: ${Innovator.Release} (minimum supported: ${MinimumRelease})" />
					<if test="${Innovator.Release != '' AND MinimumRelease != '' AND System.Version.Parse(Innovator.Release) &gt;= System.Version.Parse(MinimumRelease)}">
						<property name="Version.Check" value="true" />
					</if>
				</custom>
			</dependencies>

			<!--
				THE "MASS OPERATIONS" CATEGORY (Administration menu)

				This tool's menu entry sits under Administration, in the "Mass
				Operations" category, which comes with Aras Mass Promote. This step
				runs before the import, because the imported menu entry refers to
				the category by id.

				- When the category exists it is left exactly as it is: this step
				  never edits or deletes it.
				- When it is missing, it is added with the same ids and values as
				  Mass Promote's, so that a later Mass Promote install takes it
				  over. For the same reason it is added here and kept out of the
				  AML under Imports/: this package never claims it.

				The menu (CommandBarMenu) and the entry that places it in the
				Administration section (CommandBarSectionItem) are added by one
				item, the menu nested in related_id, so both or neither are added.

				The lookup: a query that finds nothing only warns
				(failonerror="false"), and the id it finds replaces the seeded
				"none". If the category exists but the lookup fails for another
				reason, the add below is refused (the id is taken) and the install
				stops, leaving the category untouched.

				The maintainer note at the top applies inside <if> too, AML
				included.
			-->
			<property name="FRG.MassOpsMenuId" value="none" />
			<exec action="applyaml" property="FRG.MassOpsMenuResponse" failonerror="false">
				<AML>
					<Item type="CommandBarMenu" id="69E7F9371B8C4731815FA9618F6953C3" action="get" select="id" />
				</AML>
			</exec>
			<xmlpeek text="${FRG.MassOpsMenuResponse}" xpath="//Item/@id" property="FRG.MassOpsMenuId" failonerror="false" />
			<if test="${FRG.MassOpsMenuId != 'none'}">
				<echo message="Mass Operations category found - left unchanged" />
			</if>
			<if test="${FRG.MassOpsMenuId == 'none'}">
				<echo message="Mass Operations category is missing - adding it with the ids Aras uses" />
				<exec action="applyaml" failonerror="true">
					<AML>
						<Item type="CommandBarSectionItem" id="0FA6C78004C24DFDA362FF1CC79356A0" action="add">
							<source_id>0AEAF671F8E548C494CCEC8E13F99562</source_id>
							<related_id>
								<Item type="CommandBarMenu" id="69E7F9371B8C4731815FA9618F6953C3" action="add">
									<name>com.aras.innovator.mpo.toc_Mass Operations</name>
									<label xml:lang="en">Mass Operations</label>
									<parent_menu>ED137389E93048819E68DD364EDA1322</parent_menu>
								</Item>
							</related_id>
							<action>Add</action>
							<sort_order>1152</sort_order>
							<role>A73B655731924CD0B027E4F4D5FCC0A9</role>
							<behavior>float</behavior>
						</Item>
					</AML>
				</exec>
			</if>

			<!--
				The items of the tool: everything under Imports/FRG_MassCreateEdit/,
				owned by the package definition PLMForge.MassCreateEdit.
			-->
			<import dir="${Package.Dir}/Imports/" failonerror="true" />

			<!--
				THE "Default" CONFIGURATION ITEM

				The tool reads its limits and the list of ItemTypes it may be used
				on from one FRG_MassCreateEdit_Config item named "Default". This
				step runs AFTER the import, which creates that ItemType.

				The item holds an administrator's settings, so it is kept out of
				the AML under Imports/: an imported copy would put the shipped
				values back on every upgrade. Instead:

				- When the database holds a configuration item, whatever its
				  name, it is left exactly as it is, its list of allowed
				  ItemTypes included. A renamed item is therefore safe.
				- When there is none, "Default" is added with the shipped limits (5000
				  rows per upload, 10 MB per upload, 50 items per import request,
				  4 import requests at once). Part, CAD and Document are then put on its list of
				  allowed ItemTypes, each by a request of its own.

				Part, CAD and Document belong to the Aras PLM solution
				(com.aras.innovator.solution.PLM). Each one is looked up by its
				id first. On a database that lacks it, it is skipped and the
				installer log says so; the configuration item has been added by
				then and the install carries on.

				The checks work like the one for the Mass Operations category
				above. Only the lookups carry failonerror="false". Every add
				stops the install when the server refuses it, which is also what
				happens if a lookup fails for some other reason while the item
				exists: its name is unique and its id is taken.
			-->
			<property name="FRG.DefaultConfigId" value="none" />
			<exec action="applyaml" property="FRG.DefaultConfigResponse" failonerror="false">
				<AML>
					<Item type="FRG_MassCreateEdit_Config" action="get" select="id" maxRecords="1" />
				</AML>
			</exec>
			<xmlpeek text="${FRG.DefaultConfigResponse}" xpath="//Item/@id" property="FRG.DefaultConfigId" failonerror="false" />
			<if test="${FRG.DefaultConfigId != 'none'}">
				<echo message="Configuration item found - left unchanged" />
			</if>
			<if test="${FRG.DefaultConfigId == 'none'}">
				<echo message="No configuration item found - adding Default with the shipped limits" />
				<exec action="applyaml" failonerror="true">
					<AML>
						<Item type="FRG_MassCreateEdit_Config" id="3C8C66A1559FD02C4A9F3A658E847884" action="add">
							<name>Default</name>
							<max_rows>5000</max_rows>
							<max_file_size_mb>10</max_file_size_mb>
							<batch_size>50</batch_size>
							<parallel_batches>4</parallel_batches>
						</Item>
					</AML>
				</exec>

				<!-- Part -->
				<property name="FRG.PartTypeId" value="none" />
				<exec action="applyaml" property="FRG.PartTypeResponse" failonerror="false">
					<AML>
						<Item type="ItemType" id="4F1AC04A2B484F3ABA4E20DB63808A88" action="get" select="id" />
					</AML>
				</exec>
				<xmlpeek text="${FRG.PartTypeResponse}" xpath="//Item/@id" property="FRG.PartTypeId" failonerror="false" />
				<if test="${FRG.PartTypeId == 'none'}">
					<echo message="ItemType Part is missing in this database - left out of the allowed ItemTypes" />
				</if>
				<if test="${FRG.PartTypeId != 'none'}">
					<echo message="Adding Part to the allowed ItemTypes" />
					<exec action="applyaml" failonerror="true">
						<AML>
							<Item type="FRG_MassCreateEdit_AllowedType" id="459B60981E31B66C5D2E8AF09263EAC5" action="add">
								<source_id>3C8C66A1559FD02C4A9F3A658E847884</source_id>
								<related_id>4F1AC04A2B484F3ABA4E20DB63808A88</related_id>
								<sort_order>128</sort_order>
							</Item>
						</AML>
					</exec>
				</if>

				<!-- CAD -->
				<property name="FRG.CadTypeId" value="none" />
				<exec action="applyaml" property="FRG.CadTypeResponse" failonerror="false">
					<AML>
						<Item type="ItemType" id="CCF205347C814DD1AF056875E0A880AC" action="get" select="id" />
					</AML>
				</exec>
				<xmlpeek text="${FRG.CadTypeResponse}" xpath="//Item/@id" property="FRG.CadTypeId" failonerror="false" />
				<if test="${FRG.CadTypeId == 'none'}">
					<echo message="ItemType CAD is missing in this database - left out of the allowed ItemTypes" />
				</if>
				<if test="${FRG.CadTypeId != 'none'}">
					<echo message="Adding CAD to the allowed ItemTypes" />
					<exec action="applyaml" failonerror="true">
						<AML>
							<Item type="FRG_MassCreateEdit_AllowedType" id="491F5E2FE396F93D08E6CE18083103B6" action="add">
								<source_id>3C8C66A1559FD02C4A9F3A658E847884</source_id>
								<related_id>CCF205347C814DD1AF056875E0A880AC</related_id>
								<sort_order>256</sort_order>
							</Item>
						</AML>
					</exec>
				</if>

				<!-- Document -->
				<property name="FRG.DocumentTypeId" value="none" />
				<exec action="applyaml" property="FRG.DocumentTypeResponse" failonerror="false">
					<AML>
						<Item type="ItemType" id="B88C14B99EF449828C5D926E39EE8B89" action="get" select="id" />
					</AML>
				</exec>
				<xmlpeek text="${FRG.DocumentTypeResponse}" xpath="//Item/@id" property="FRG.DocumentTypeId" failonerror="false" />
				<if test="${FRG.DocumentTypeId == 'none'}">
					<echo message="ItemType Document is missing in this database - left out of the allowed ItemTypes" />
				</if>
				<if test="${FRG.DocumentTypeId != 'none'}">
					<echo message="Adding Document to the allowed ItemTypes" />
					<exec action="applyaml" failonerror="true">
						<AML>
							<Item type="FRG_MassCreateEdit_AllowedType" id="FA83E1306FDA155B714F5186840CF3DF" action="add">
								<source_id>3C8C66A1559FD02C4A9F3A658E847884</source_id>
								<related_id>B88C14B99EF449828C5D926E39EE8B89</related_id>
								<sort_order>384</sort_order>
							</Item>
						</AML>
					</exec>
				</if>
			</if>
		</module>
	</installation>
</package>
